<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="100%" height="100%">
  <defs>
    <linearGradient id="new-games-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ff7300" />
      <stop offset="50%" stop-color="#ef8c16" />
      <stop offset="100%" stop-color="#111823" />
    </linearGradient>
    <filter id="card-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  <!-- Background Card -->
  <rect x="5" y="5" width="390" height="490" rx="20" fill="#111823" stroke="rgba(255,255,255,0.05)" stroke-width="2" />
  <!-- Glowing Overlay -->
  <rect x="15" y="15" width="370" height="470" rx="15" fill="url(#new-games-grad)" opacity="0.15" />
  
  <!-- Sparkles -->
  <circle cx="80" cy="80" r="2" fill="#fff" opacity="0.8" filter="url(#card-glow)" />
  <circle cx="320" cy="150" r="3" fill="#ffc558" opacity="0.6" filter="url(#card-glow)" />
  <circle cx="100" cy="380" r="1.5" fill="#fff" opacity="0.5" />
  
  <!-- Crown Icon Vector -->
  <g transform="translate(160, 80)" fill="url(#new-games-grad)" filter="url(#card-glow)">
    <path d="M10,40 L25,15 L40,30 L55,15 L70,40 Z" />
    <rect x="10" y="44" width="60" height="6" rx="2" />
  </g>
  
  <!-- Large Title -->
  <text x="200" y="240" font-family="'Outfit', 'Inter', sans-serif" font-weight="900" font-size="34" fill="#ffffff" text-anchor="middle" letter-spacing="2">NEW RELEASES</text>
  <text x="200" y="280" font-family="'Outfit', 'Inter', sans-serif" font-weight="700" font-size="16" fill="#ffc558" text-anchor="middle" letter-spacing="4">LIVE DEALERS &amp; CASINOS</text>
  <text x="200" y="320" font-family="'Outfit', sans-serif" font-weight="500" font-size="14" fill="#8b9aae" text-anchor="middle" opacity="0.8">Experience premium sports betting &amp; casinos</text>
  
  <!-- Button "Explore Games" -->
  <g transform="translate(100, 370)">
    <rect x="0" y="0" width="200" height="48" rx="24" fill="linear-gradient(135deg, #ffc558 0%, #ff7300 100%)" />
    <!-- Fallback single fill as svg linearGradient -->
    <rect x="0" y="0" width="200" height="48" rx="24" fill="#ff8c00" />
    <text x="100" y="28" font-family="'Outfit', sans-serif" font-weight="900" font-size="14" fill="#000000" text-anchor="middle" letter-spacing="2">PLAY NOW</text>
  </g>
</svg>
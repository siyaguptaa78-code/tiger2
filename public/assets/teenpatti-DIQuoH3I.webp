<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 240" width="100%" height="100%">
  <defs>
    <linearGradient id="bg-grad-Teenpatti" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff9966" />
      <stop offset="100%" stop-color="#ff5e62" />
    </linearGradient>
    <filter id="glow-effect" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  <!-- Background Card -->
  <rect x="5" y="5" width="390" height="230" rx="15" fill="#111823" stroke="rgba(255,255,255,0.06)" stroke-width="2" />
  <!-- Accent Glow Top -->
  <path d="M 5,30 Q 200,80 395,30" fill="none" stroke="url(#bg-grad-Teenpatti)" stroke-width="3" opacity="0.3" filter="url(#glow-effect)" />
  <!-- Icon or Graphic -->
  <g transform="translate(40, 95)" opacity="0.85">
    <rect x="15" y="20" width="35" height="50" rx="5" fill="none" stroke="#ff5e62" stroke-width="3" transform="rotate(-15 32 45)" />
   <rect x="35" y="20" width="35" height="50" rx="5" fill="none" stroke="#ff9966" stroke-width="3" transform="rotate(15 52 45)" />
   <text x="45" y="52" fill="#fff" font-weight="900" font-size="16" text-anchor="middle">A</text>
  </g>
  <!-- Game Title -->
  <text x="180" y="115" font-family="'Outfit', 'Inter', sans-serif" font-weight="900" font-size="30" fill="#ffffff" letter-spacing="1">TEENPATTI</text>
  <text x="180" y="145" font-family="'Outfit', 'Inter', sans-serif" font-weight="700" font-size="14" fill="url(#bg-grad-Teenpatti)" letter-spacing="3">INDIAN POKER</text>
  
  <!-- "Play Now" Hover Accent -->
  <g transform="translate(180, 168)" opacity="0.9">
    <rect x="0" y="0" width="110" height="32" rx="16" fill="url(#bg-grad-Teenpatti)" />
    <text x="55" y="21" font-family="'Outfit', sans-serif" font-weight="900" font-size="12" fill="#000000" text-anchor="middle" letter-spacing="1">PLAY NOW</text>
  </g>
</svg>